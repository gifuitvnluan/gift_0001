# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL"

# ============ APP CONTENT CONFIGURATION ============
# All text, images, and audio can be customized via these environment variables.

# App Title (shows in browser tab)
VITE_TITLE="Gửi đến Linh"

# Welcome Screen Text
VITE_WELCOME_HEADING="Thế Giới Tình Yêu"
VITE_WELCOME_SUBHEADING="Chào mừng Linh đặt chân tới"
VITE_WELCOME_DESCRIPTION="Mô tả chào mừng..."
VITE_WELCOME_BUTTON="Thắp Sáng Món Quà ❤️"

# Tagline and Subtitle
VITE_TAGLINE="Chúc mừng Ngày Phụ nữ Việt Nam 20/10"
VITE_SUBTITLE="Dành tặng cho Linh"

# Letter Content (4 paragraphs)
VITE_LETTER_PARA_1="Đoạn thư 1..."
VITE_LETTER_PARA_2="Đoạn thư 2..."
VITE_LETTER_PARA_3="Đoạn thư 3..."
VITE_LETTER_PARA_4="Đoạn thư 4..."
VITE_LETTER_GREETING="Linh thương mến của anh ❤️,"
VITE_LETTER_SIGNOFF="Yêu Linh hơn ngàn vạn tinh cầu,\nChàng trai luôn bảo vệ em"

# Promises (5 promises)
VITE_PROMISE_1="Lời hứa 1..."
VITE_PROMISE_2="Lời hứa 2..."
VITE_PROMISE_3="Lời hứa 3..."
VITE_PROMISE_4="Lời hứa 4..."
VITE_PROMISE_5="Lời hứa 5..."

# Memories
VITE_MEMORY_1_TITLE="Kỷ niệm 1 🌸"
VITE_MEMORY_1_DESC="Mô tả kỷ niệm 1..."
VITE_MEMORY_1_TAG="First Date"
VITE_MEMORY_2_TITLE="Kỷ niệm 2 ☀️"
VITE_MEMORY_2_DESC="Mô tả kỷ niệm 2..."
VITE_MEMORY_2_TAG="Sweet Smile"
VITE_MEMORY_3_TITLE="Kỷ niệm 3 🌅"
VITE_MEMORY_3_DESC="Mô tả kỷ niệm 3..."
VITE_MEMORY_3_TAG="Sunset Memories"

# Audio Playlist (JSON format - override entire playlist)
# VITE_PLAYLIST='[{"title":"Custom Song","artist":"Artist","url":"https://example.com/audio.mp3","durationMs":180000}]'

# Default Images (JSON format - override entire default image gallery)
# VITE_DEFAULT_IMAGES='[{"id":"img1","url":"https://example.com/image1.jpg","caption":"Caption 1","date":"Date 1"},{"id":"img2","url":"https://example.com/image2.jpg","caption":"Caption 2","date":"Date 2"}]'

# 3D Orbits (satellite text around heart)
VITE_ORBIT_1="❤️ YOUR_NAME ❤️"
VITE_ORBIT_2="❤️ I LOVE YOU ❤️"
VITE_ORBIT_3="❤️ DATE ❤️"
VITE_ORBIT_4="❤️ FOREVER ❤️"